rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function guest() { return request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function settingsPath(uid) { return /databases/$(database)/documents/users/$(uid)/settings/main; }
    function nextSettings(uid) { return getAfter(settingsPath(uid)).data; }
    function oldRevision(uid) { return exists(settingsPath(uid)) ? get(settingsPath(uid)).data.revision : 0; }
    function revisionAdvanced(uid) { return nextSettings(uid).revision == oldRevision(uid) + 1; }
    function validSettings(data) {
      return data.keys().hasOnly(['theme','budget','revision','guestHangoutId','updatedAt'])
        && data.keys().hasAll(['theme','budget','revision','guestHangoutId','updatedAt'])
        && data.theme in ['lavender','ocean','rose','forest','night']
        && data.budget is number && data.budget > 0 && data.budget <= 1000000000
        && data.revision is int && data.revision > 0
        && data.guestHangoutId is string && data.guestHangoutId.size() <= 100
        && data.updatedAt == request.time;
    }
    function validHangout(data,id) {
      return data.keys().hasOnly(['id','place','date','emoji','people','selfIndex'])
        && data.id == id && data.place is string && data.place.size() > 0 && data.place.size() <= 100
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.emoji is string && data.emoji.size() <= 16
        && data.people is list && data.people.size() > 0 && data.people.size() <= 100
        && data.selfIndex is int && data.selfIndex >= 0 && data.selfIndex < data.people.size();
    }
    function validPlan(data,id) {
      return data.keys().hasOnly(['id','place','date','estimate','friends'])
        && data.id == id && data.place is string && data.place.size() > 0 && data.place.size() <= 100
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.estimate is number && data.estimate >= 0 && data.estimate <= 100000000
        && data.friends is string && data.friends.size() <= 2000;
    }
    match /users/{uid}/settings/main {
      allow read: if owner(uid);
      allow create: if owner(uid) && validSettings(request.resource.data) && request.resource.data.revision == 1
        && (!guest() || request.resource.data.guestHangoutId == ''
          || existsAfter(/databases/$(database)/documents/users/$(uid)/hangouts/$(request.resource.data.guestHangoutId)));
      allow update: if owner(uid) && validSettings(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1
        && (!guest() || request.resource.data.guestHangoutId == resource.data.guestHangoutId
          || (resource.data.guestHangoutId == ''
            && existsAfter(/databases/$(database)/documents/users/$(uid)/hangouts/$(request.resource.data.guestHangoutId))));
      // Retain the guest's used slot; deleting/recreating settings cannot reset the limit.
      allow delete: if false;
    }
    match /users/{uid}/hangouts/{id} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && validHangout(request.resource.data,id) && revisionAdvanced(uid)
        && (!guest() || nextSettings(uid).guestHangoutId == id);
      allow delete: if owner(uid) && revisionAdvanced(uid);
    }
    match /users/{uid}/plans/{id} {
      allow read: if owner(uid);
      allow create, update: if owner(uid) && !guest() && validPlan(request.resource.data,id) && revisionAdvanced(uid);
      allow delete: if owner(uid) && !guest() && revisionAdvanced(uid);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
